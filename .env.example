# ═══════════════════════════════════════════════════════════
# DEODES — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in the values
#
# This file is the ONLY env file tracked by git and it must never
# contain a real value. `.env` and every other `.env.*` variant are
# gitignored — put working credentials there, not here.
# ═══════════════════════════════════════════════════════════

# Wallet session HMAC key — cryptographically random hex string (32+ bytes / 64+ hex chars)
# This key protects localStorage session data from tampering. It is fetched by the
# client once per page load via GET /api/wallet/hmac/key and never enters the JS bundle.
#
# Generate a new one: `openssl rand -hex 32`
# Rotate by replacing the value and restarting the server. Old HMACs become invalid,
# so sessions are re-fetched cleanly. Plan rotation windows accordingly.
#
# REQUIRED in production — without it the server returns 500 on the key endpoint.
# Leave empty here and set a real value via deodes-env (it can generate one).
WALLET_HMAC_KEY=

# Google OAuth ("Continue with Google")
# Create credentials at https://console.cloud.google.com/apis/credentials
# (OAuth client ID, Web application) with authorized redirect URI:
#   https://deodes.com/api/auth/google/callback
# (local dev: http://localhost:1110/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Passkey WebAuthn Configuration
# RP ID: use "localhost" for dev, your domain for production
NEXT_PUBLIC_PASSKEY_RP_ID=localhost
# Server-side pepper (never exposed to client). Used for wallet key
# derivation, so treat it like a signing key: generate a unique value per
# environment and never commit it. Production refuses to boot without it.
PASSKEY_SERVER_PEPPER=
# Expected origin for WebAuthn verification — must match client origin exactly
PASSKEY_EXPECTED_ORIGIN=http://localhost:1110

# Arc Network Configuration (DEODES builds on Arc)
# Values verified against docs.arc.io/arc/references/connect-to-arc.
# Mainnet chain ID 5042, testnet 5042002. USDC (18 decimals) is the gas token.
# Set to "mainnet" for production. Defaults to "testnet" if not set.
NEXT_PUBLIC_ARC_NETWORK=testnet
# Optional overrides (defaults shown):
# NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
# NEXT_PUBLIC_ARC_CHAIN_ID=5042002
# NEXT_PUBLIC_ARC_EXPLORER_URL=https://testnet.explorer.arc.io
# DeodesCircle deployment — source of truth is
# deodes-contracts/deployments.{testnet,mainnet}.json (Phase 0.5 freeze).
# Testnet: 0x70A7CCB7b5fe856384Aab3aAF553E09A10AF14A4. Empty = contract calls
# fail fast with "contract not configured" instead of hitting UNCONFIGURED_*.
# NEXT_PUBLIC_DEODES_CONTRACT_ID=0x70A7CCB7b5fe856384Aab3aAF553E09A10AF14A4

# Circle App Kit Onramp (card/bank → USDC on Arc)
# Keys from https://console.circle.com/api-keys — SERVER ONLY, never NEXT_PUBLIC.
# Sandbox key enables test money, production key moves real money.
# Either empty = /api/onramp/sessions returns 503 for that env.
CIRCLE_TEST_API_KEY=
CIRCLE_API_KEY=
# Active env: "sandbox" (default) or "production". Deployment config, not a
# runtime toggle — restart to change. No admin flip on purpose.
CIRCLE_ENV=sandbox
# Wallets-api base URL for session minting. Leave empty for per-env defaults:
# sandbox → https://api-test.circle.com, production → https://api.circle.com.
# Set only to point at a staging mock or emulator.
# CIRCLE_BASE_URL=
# (alias of the above)
# ONRAMP_API_BASE_URL=
# Hosted widget origin the browser mounts. Leave empty for per-env defaults:
# sandbox → https://onramp-sandbox.arc.io, production → https://onramp.arc.io.
# Server override (used by GET /api/onramp/sessions probe + session minting):
# CIRCLE_WIDGET_BASE_URL=
# (alias of the above)
# ONRAMP_WIDGET_BASE_URL=
# Client-side override for the same origin (optional; the widget prefers the
# server probe, then these). Set only if the probe is unreachable at build:
# NEXT_PUBLIC_CIRCLE_WIDGET_BASE_URL=
# (alias of the above)
# NEXT_PUBLIC_ONRAMP_WIDGET_BASE_URL=
# Bare hostname of the embedding page (no scheme/port). Falls back to the
# request host. Required in production for debit card / Apple Pay / Google Pay.
ONRAMP_REFERRER_DOMAIN=
# Circle Onramp webhook reconciliation (POST /api/onramp/webhook)
# Browser DEPOSIT_SETTLED events are best-effort UX only; the webhook is the
# source of truth for mainnet deposits. Register this URL in Console:
#   https://<your-domain>/api/onramp/webhook
# (local dev: expose the dev server with a tunnel — Circle must reach the URL.)
# Shared secret for HMAC-SHA256 verification of the raw request body
# (digest in the x-circle-signature header). Without it the route returns
# 503 fail-closed rather than accepting unverified deposits.
# CIRCLE_WEBHOOK_SECRET=
# (alias of the above)
# ONRAMP_WEBHOOK_SECRET=
# Set to "true" to show the Circle rail option on the deposit page.
NEXT_PUBLIC_ONRAMP_ENABLED=false

# API Configuration
# NEXT_PUBLIC_API_URL=http://localhost:3001

# Explore page source: auto (live API, mock fallback), live, or mock.
# NEXT_PUBLIC_EXPLORE_SOURCE=auto

